# QDKEP Knowledge Console — environment template
# Copy this file to ".env" and fill in your real values.
# The real .env is loaded automatically on server start and must NEVER be committed.

# Supabase Postgres connection string (Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Anthropic API key for answer generation (optional; retrieval/search work without it)
ANTHROPIC_API_KEY=sk-ant-...

# Optional server bind overrides
# QDKEP_HOST=127.0.0.1
# QDKEP_PORT=8800

